{
  "expo": {
    "name": "my-project",
    "slug": "my-project",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/ghost-travel-icon.png",
    "scheme": "myproject",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/ghost-travel-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#13274a",
        "foregroundImage": "./assets/brand/ghost-travel-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.roxana.coste.myproject"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/ghost-travel-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2e15082c-1966-4d13-a0e9-1e1a840c736a"
      }
    }
  }
}
