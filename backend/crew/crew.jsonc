{
  "name": "Ghost Travel Itinerary",
  "agents": [
    "flight_hunter",
    "local_explorer",
    "chief_concierge"
  ],
  "tasks": [
    {
      "name": "flight_research",
      "description": "Analyze potential flight options from {origin} to {destination} for a {duration} trip.\nDeparture date: {departure_date}. Last trip day: {end_date}.\nWrite your response in {language}.\nWhen the departure date is specified, call search_flights once without arguments to look up the current trip. If the tool returns options, preserve each route and fare exactly and explain that these are outbound search results for one adult and prices may change. Otherwise give clearly labeled unverified route suggestions and broad estimates where supportable. Never invent flight numbers, exact times, or bookable fares. The full trip budget is {budget}.",
      "expected_output": "Outbound search results with their fare caveat, or clearly labeled unverified planning suggestions.",
      "agent": "flight_hunter",
      "output_pydantic": {
        "python": "itinerary_models.FlightResearch"
      }
    },
    {
      "name": "local_research",
      "description": "Suggest 4-5 interesting attractions and 3 local restaurants in {destination}.\nSelect enough options for {duration} and respect the total trip budget of {budget}.\nTrip dates: {departure_date} through {end_date}; consider season and weekday closures.\nWrite your response in {language}.\nDo not invent ratings, current opening hours, or claims of verification.\nLabel prices and closure information as unverified.\nAvoid standard traps like overpriced central plazas; find spots loved by locals.\nCall find_places once with city set to {destination} and category set to museum. It only supports museums. Use general knowledge for other attractions and restaurants.\nIf it returns museums, include one in the attractions, preserving its exact name\nand identifying it as coming from OpenStreetMap via LatLng. If no results\nare returned, continue with general suggestions and do not attribute them to the tool.",
      "expected_output": "A curated list of hidden gems, local food spots, and short descriptions of why they are special.",
      "agent": "local_explorer",
      "output_pydantic": {
        "python": "itinerary_models.LocalResearch"
      }
    },
    {
      "name": "itinerary_coordinator",
      "description": "Review the flight options and local spots provided by the other agents.\nCreate an itinerary covering exactly {duration} for {destination}, assessing the requested total {budget} budget honestly.\nTreat this as the total trip budget including flights, accommodation, food, and activities.\nPreserve provider flight details and their caveat when Flight Hunter found results. If selecting an outbound option as a planning assumption, use its final arrival date and time to keep earlier activities flexible and state the assumption. Return timing is unknown. If no search results are available, keep both travel days flexible and do not add exact flight details. Keep the full-trip flight budget as an estimate or unknown, since outbound fares cover only one leg.\nInclude a reminder in {language} to verify routes, schedules, and prices before booking.\nTrip dates: {departure_date} through {end_date}. When dates are specified, include\nthe calendar date in each day object. The departure date is Day 1.\nIf local research includes a museum from OpenStreetMap via LatLng, schedule it\nas an activity. Preserve its exact place name and credit OpenStreetMap via LatLng in its details.\nGroup activities logically by neighborhood so the traveler doesn't waste time crossing the city.\nReturn structured data matching the Itinerary schema, not Markdown or code fences.\nWrite all user-facing text in {language}; keep schema keys and period enum values unchanged.\nSupply an overview, flight options and their verification caveat, accommodation advice,\nnumbered days with ISO dates (null if unspecified), and morning/afternoon/evening activities.\nEach activity needs a title, place, details, and estimated EUR cost (null if unknown).\nSupply total-trip budget categories with estimated numeric EUR amounts (null if unknown),\nusing distinct, non-overlapping categories. Include flights, accommodation, food,\nactivities and local transport, marking any unknown amounts as null. Do not include\ntotal or subtotal rows; Python calculates the sum. Never claim an unknown cost is free.\nUse each budget kind at most once; do not overlap categories or include totals.\nDo not lower estimates to force the trip within budget. When funds appear insufficient,\nexplain the limitation and suggest practical changes (dates, fewer nights, closer destination)\nin budget_advice without claiming verified savings. When costs are unknown, state that\naffordability cannot be confirmed. Do not promise that the trip fits the budget.\nInclude explanatory budget notes and practical tips. Do not put weekday names in day titles.\nKeep text concise. Never use zero as a substitute for an unknown cost.",
      "expected_output": "A structured Itinerary object containing localized travel advice, individual days and activities, estimated numeric EUR costs or null, and explicit flight uncertainty.",
      "agent": "chief_concierge",
      "output_pydantic": {
        "python": "itinerary_models.Itinerary"
      },
      "context": [
        "flight_research",
        "local_research"
      ]
    }
  ],
  "process": "sequential",
  "verbose": true
}
